TC_ENVIRONMENT=development
TC_HOST=127.0.0.1
TC_PORT=8000
TC_LOG_LEVEL=info
FRONTEND_ORIGIN=http://127.0.0.1:5173
TC_DATABASE_URL=postgresql+psycopg://triathlon:triathlon@localhost:5432/triathlon_coach

# Authentication foundation. Session mode requires a valid server-side session cookie.
TC_AUTH_MODE=development
TC_SESSION_COOKIE_NAME=tricoach_session
TC_SESSION_TTL_SECONDS=1209600
TC_SESSION_COOKIE_SECURE=false
TC_SESSION_COOKIE_SAMESITE=lax
TC_SESSION_COOKIE_PATH=/
TC_CSRF_COOKIE_NAME=tricoach_csrf
TC_CSRF_HEADER_NAME=X-CSRF-Token
TC_LOGIN_RATE_LIMIT_FAILURES=5
TC_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
TC_LOGIN_RATE_LIMIT_MAX_KEYS=10000
TC_MAX_ACTIVE_SESSIONS_PER_USER=10
TC_REVOKED_SESSION_RETENTION_DAYS=30

# Replace placeholders locally. Never commit real Strava credentials.
STRAVA_CLIENT_ID=replace_with_strava_client_id
STRAVA_CLIENT_SECRET=replace_with_strava_client_secret
STRAVA_REDIRECT_URI=http://127.0.0.1:8000/integrations/strava/callback
STRAVA_AUTHORIZATION_URL=https://www.strava.com/oauth/authorize
STRAVA_TOKEN_URL=https://www.strava.com/oauth/token
STRAVA_REVOCATION_URL=https://www.strava.com/oauth/revoke
STRAVA_API_BASE_URL=https://www.strava.com/api/v3
STRAVA_SCOPES=read,activity:read_all
OAUTH_STATE_TTL_SECONDS=600
OAUTH_STATE_SQLITE_PATH=.oauth-state/oauth_state.sqlite3
OAUTH_STATE_DIAGNOSTICS=false
STRAVA_IMPORT_PAGE_SIZE=100
STRAVA_IMPORT_RETRY_SECONDS=60
STRAVA_IMPORT_OVERLAP_SECONDS=86400
TC_ACTIVITY_STREAM_RETENTION_ENABLED=true
TC_ACTIVITY_LOCATION_STREAM_RETENTION_ENABLED=false
TC_ACTIVITY_STREAM_MAX_SAMPLES=1000
TC_ACTIVITY_STREAM_RETENTION_DAYS=0

# Comma-separated development origins are supported by the CORS policy
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Competition catalog (0.8E.7B)
TC_WORLD_TRIATHLON_ENABLED=false
TC_WORLD_TRIATHLON_API_KEY=replace_with_world_triathlon_api_key
TC_WORLD_TRIATHLON_API_BASE_URL=https://api.triathlon.org/v1
TC_COMPETITION_CATALOG_TIMEOUT_SECONDS=10

# AI-assisted live web competition search (backend only)
TC_AI_WEB_COMPETITION_ENABLED=false
TC_OPENAI_API_KEY=replace_with_openai_api_key
TC_AI_WEB_COMPETITION_MODEL=gpt-5.6
TC_AI_WEB_COMPETITION_TIMEOUT_SECONDS=30
TC_AI_WEB_COMPETITION_MAX_RESULTS=10

# Deterministic Tavily web competition search (backend only)
TC_TAVILY_COMPETITION_ENABLED=false
TC_TAVILY_API_KEY=replace_with_tavily_api_key
TC_TAVILY_COMPETITION_SEARCH_DEPTH=basic
TC_TAVILY_COMPETITION_TIMEOUT_SECONDS=15
TC_TAVILY_COMPETITION_MAX_RESULTS=20
TC_TAVILY_COMPETITION_USE_EXTRACT=true
